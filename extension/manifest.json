{
  "manifest_version": 3,
  "name": "YT Temporal Comments",
  "version": "0.2.0",
  "description": "Guardá notas privadas con marcadores de color en momentos exactos de videos de YouTube y encontralas en tu propia línea de tiempo.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "YT Temporal Comments",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "src/utils/common.js",
        "src/storage/store.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/content.css"
      ],
      "matches": [
        "*://*.youtube.com/*"
      ]
    }
  ]
}
